# FAKE credentials for the target app. Copy to `.env`.
# These are intentionally worthless demo values. They exist so the scenario
# looks like a real service and so detection tooling has something to "protect".
# The demonstration payload NEVER reads these -- it only proves it *could*.

DATABASE_URL=postgresql://demo_user:demo_password@localhost:5432/acme_prod
THIRD_PARTY_API_KEY=sk-demo-0000000000000000000000000000
JWT_SIGNING_SECRET=demo-not-a-real-secret-change-me
INTERNAL_SERVICE_TOKEN=svc-demo-token-0000
